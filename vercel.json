{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/HI02H11_L02_S05_DEV_HANDOFF/3_BUILD/HI02H11_L02_S05.html"
    },
    {
      "source": "/index.html",
      "destination": "/HI02H11_L02_S05_DEV_HANDOFF/3_BUILD/HI02H11_L02_S05.html"
    },
    {
      "source": "/HI02H11_L02_S05.html",
      "destination": "/HI02H11_L02_S05_DEV_HANDOFF/3_BUILD/HI02H11_L02_S05.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/HI02H11_L02_S05_DEV_HANDOFF/3_BUILD/assets/UI/favicon.ico"
    },
    {
      "source": "/assets/:path*",
      "destination": "/HI02H11_L02_S05_DEV_HANDOFF/3_BUILD/assets/:path*"
    },
    {
      "source": "/card.json",
      "destination": "/HI02H11_L02_S05_DEV_HANDOFF/3_BUILD/card.json"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/card.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/MatraRunner/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/Audio/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
